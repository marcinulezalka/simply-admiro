{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simplysmart/admiro",
    "type": "library",
    "description": "Admiro: the core of simplysmart applications (database, zones, sign-in, permissions, localization, UI), the administrators' zone and the developer toolbox (SemVer releases, private packages, deployment).",
    "keywords": [
        "simplysmart",
        "admiro",
        "core",
        "modular",
        "zones",
        "administration",
        "database",
        "tools",
        "semver",
        "changelog",
        "release",
        "deploy"
    ],
    "homepage": "https://github.com/marcinulezalka/simply-admiro",
    "license": "proprietary",
    "authors": [
        {
            "name": "Marcin Ulezalka",
            "email": "marcin.ulezalka@simplysmart.pl",
            "role": "Founder"
        }
    ],
    "support": {
        "issues": "https://github.com/marcinulezalka/simply-admiro/issues",
        "source": "https://github.com/marcinulezalka/simply-admiro"
    },
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "laravel/framework": "^13.0",
        "outhebox/blade-flags": "^1.7",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Mainboard\\": "src/",
            "Simplysmart\\Admiro\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Simplysmart\\Admiro\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/simplysmart",
        "bin/version-release",
        "bin/composer-private"
    ],
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simplysmart\\Mainboard\\MainboardServiceProvider",
                "Simplysmart\\Admiro\\Panel\\PanelServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
