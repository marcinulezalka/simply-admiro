{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simplysmart/mainboard",
    "type": "library",
    "description": "Modular mainboard for simplysmart applications: connect modules, management workspaces, and beyond.",
    "keywords": [
        "simplysmart",
        "mainboard",
        "modular",
        "modules"
    ],
    "homepage": "https://github.com/marcinulezalka/simply-mainboard",
    "license": "proprietary",
    "authors": [
        {
            "name": "Marcin Ulezalka",
            "email": "marcin.ulezalka@simplysmart.pl",
            "role": "Founder"
        }
    ],
    "support": {
        "issues": "https://github.com/marcinulezalka/simply-mainboard/issues",
        "source": "https://github.com/marcinulezalka/simply-mainboard"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "outhebox/blade-flags": "^1.7"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Mainboard\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simplysmart\\Mainboard\\MainboardServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
