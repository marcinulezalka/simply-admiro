use Simplysmart\Admiro\Tools\Console\Application;
use Simplysmart\Admiro\Tools\Console\Command;
use Simplysmart\Admiro\Tools\Console\DeployCommand;
use Simplysmart\Admiro\Tools\Console\PresetCommand;
use Simplysmart\Admiro\Tools\Console\PrivatePackagesCommand;
use Simplysmart\Admiro\Tools\Console\VersionReleaseCommand;
use Simplysmart\Admiro\Tools\Deploy\DeployMode;
use Simplysmart\Admiro\Tools\Deploy\RemoteScript;
use Simplysmart\Admiro\Tools\Deploy\RepositoryCheck;
use Simplysmart\Admiro\Tools\PrivatePackages\GitRepositorySource;
use Simplysmart\Admiro\Tools\PrivatePackages\ProcessComposerRunner;
use Simplysmart\Admiro\Tools\Process\SystemProcessRunner;
use Simplysmart\Admiro\Tools\Release\ReleaseClock;
use Simplysmart\Admiro\Tools\Release\ReleasePlanner;
use Simplysmart\Admiro\Tools\Release\VersionRelease;

require $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__) . '/vendor/autoload.php';

$processes = new SystemProcessRunner();
$privatePackages = new PrivatePackagesCommand(new ProcessComposerRunner());
$repositories = new RepositoryCheck($processes, new GitRepositorySource($processes));
$script = RemoteScript::fromPackage();
$lockCommand = static fn(?array $composer): Command => new PrivatePackagesCommand(new ProcessComposerRunner($composer));
// Pytanie o produkcję (deploy <projekt>): odpowiedź z terminala; bez terminala (CI, potok) zawsze „nie”.
$confirm = static function (string $question): bool {
    if (! stream_isatty(STDIN)) {
        fwrite(STDOUT, $question . "nie (brak terminala; użyj --production)\n");

        return false;
    }

    fwrite(STDOUT, $question);

    return in_array(mb_strtolower(trim((string) fgets(STDIN))), ['t', 'tak', 'y', 'yes'], true);
};

$application = new Application([
    new VersionReleaseCommand(new VersionRelease(new ReleasePlanner(), ReleaseClock::fromEnvironment())),
    $privatePackages,
    new PresetCommand('deploy:lock', 'Manifest wdrożeniowy composer.deploy.json/.lock z paczkami z repozytoriów git', $privatePackages, [PrivatePackagesCommand::DEPLOY]),
    new DeployCommand(DeployMode::Deploy, $processes, $repositories, $script, $lockCommand, $confirm),
    new DeployCommand(DeployMode::Onboarding, $processes, $repositories, $script, $lockCommand, $confirm),
    new DeployCommand(DeployMode::Fresh, $processes, $repositories, $script, $lockCommand, $confirm),
]);

exit($application->run(array_slice($_SERVER['argv'], 1), (string) getcwd(), STDOUT, STDERR));
